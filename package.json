{
  "name": "cascadia-field-notes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.23.4" },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "check": "astro check",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build": "astro build",
    "test:site": "node scripts/check-site.mjs",
    "test:browser": "python scripts/check-browser.py",
    "verify": "npm run check && npm test && npm run build && npm run test:site",
    "preview": "astro preview --host 0.0.0.0"
  },
  "dependencies": { "astro": "^7.4.2", "@astrojs/sitemap": "^3.6.0" },
  "devDependencies": { "@astrojs/check": "^0.9.6", "typescript": "^5.9.3" }
}
