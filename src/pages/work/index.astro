---
import Layout from '../../layouts/Layout.astro';
import PageTitle from '../../components/PageTitle.astro';
import { getCollection } from 'astro:content';
const projects = (await getCollection('projects')).sort((a,b)=>a.data.priority-b.data.priority);
const archive = [
  { title: 'LearnML', kind: 'Learning fork', text: 'Fork of Microsoft’s ML-For-Beginners curriculum. Educational material; not an original course or research project.', url: 'https://github.com/akaashbella/LearnML' },
  { title: 'speedscore-test', kind: 'Academic exercise · fork', text: 'GitHub Classroom lab for reviewing SpeedScore’s Delete Round functionality. Not presented as an independently authored application.', url: 'https://github.com/akaashbella/speedscore-test' },
  { title: 'SMTPulse', kind: 'External project fork', text: 'Fork of Adnan-D-Luffy/SMTPulse, a Node.js SMTP email sender. No specific upstream contribution is claimed.', url: 'https://github.com/akaashbella/SMTPulse' },
  { title: 'claw-code', kind: 'External project fork', text: 'Fork of ultraworkers/claw-code. Upstream authorship and project results belong to that project; not featured as original work.', url: 'https://github.com/akaashbella/claw-code' },
];
---
<Layout title="Work" description="Selected research, independent software projects, and interdisciplinary work by Akaash Bella, with source-backed case studies and clear implementation status.">
  <PageTitle number="01" label="The work index" title="Questions made tangible." intro="Research infrastructure, small software systems, and interdisciplinary projects. A selected record of what I’m building and how I think." />
  <section class="wrap work-list" aria-label="Curated project case studies">{projects.map((project,i)=><article class="work-entry"><span class="meta work-number">{String(i+1).padStart(2,'0')}</span><div><p class="eyebrow">{project.data.category}</p><h2><a href={`/work/${project.id}/`}>{project.data.title} <span aria-hidden="true">↗</span></a></h2><p>{project.data.summary}</p><p class="caption">{project.data.status}</p></div><div class="work-entry-side"><p class="meta">{project.data.period}</p><p>{project.data.technologies.join(' / ')}</p><a class="text-link" href={`/work/${project.id}/`}>Read case study <span aria-hidden="true">→</span></a></div></article>)}</section>
  <section class="chapter wrap archive"><div class="section-heading"><div><p class="eyebrow">04 / Further reading</p><h2>The wider shelf.</h2></div><p class="caption">Learning and external projects,<br />with authorship kept clear.</p></div>{archive.map(item=><article class="archive-row"><div><h3><a href={item.url}>{item.title} ↗</a></h3><span class="meta">{item.kind}</span></div><p>{item.text}</p></article>)}<p class="caption source-note">Public repository metadata and documentation reviewed October 22, 2026. Fork presence does not establish an upstream contribution. FitTrack is private and uses only the owner-supplied description.</p></section>
</Layout>
